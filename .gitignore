# Virtual environment - disposable, path-specific, rebuilt from requirements.txt
venv/

# Python cache files
__pycache__/
*.pyc

# Saved model artifacts (large binaries, regenerated by scripts)
models/*.pkl

# Data files (large, re-fetchable via fetch_data.py)
data/*.csv

# Output plots/results (regenerated)
outputs/*.png
outputs/*.csv
*:Zone.Identifier
*.save
